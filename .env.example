# Copy to .env.local and fill in what you need. Never commit real values.

# Your production address, used for the sitemap, robots.txt and social cards.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: every new signup is also POSTed here as JSON (Zapier, Make, n8n, Slack workflow, your own API).
WAITLIST_WEBHOOK_URL=

# Optional: where the local JSON file lives. Defaults to ./data/waitlist.json
# WAITLIST_FILE=./data/waitlist.json

# Optional: set to 1 on hosts with a read only disk so only the webhook is used.
# WAITLIST_DISABLE_FILE=1
